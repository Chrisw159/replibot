# === Database ===
# A strong random password for the PostgreSQL database
POSTGRES_PASSWORD=change_me_to_a_strong_random_password

# === Sessions ===
# A long random string for signing sessions — run: openssl rand -hex 32
SESSION_SECRET=change_me_to_a_long_random_string

# === AI (xAI / Grok) ===
# Your xAI API key — get one from https://console.x.ai
XAI_API_KEY=xai-...

# === Betfair ===
# These can also be entered via the Settings page in the UI after launch
BETFAIR_USERNAME=your_betfair_email
BETFAIR_PASSWORD=your_betfair_password
BETFAIR_APP_KEY=your_live_app_key

# === Server ===
# Port to expose on the host machine (default: 80)
# Change to 8888 if using a reverse proxy (Caddy/Nginx) for HTTPS
HOST_PORT=80
