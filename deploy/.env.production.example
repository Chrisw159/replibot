# === Database ===
# A strong random password for the PostgreSQL database
POSTGRES_PASSWORD=change_me_to_a_strong_random_password

# === Sessions ===
# A long random string for signing sessions
SESSION_SECRET=change_me_to_a_long_random_string

# === OpenAI ===
# Your real OpenAI API key (get one from platform.openai.com)
OPENAI_API_KEY=sk-...

# === Betfair (optional — can also be set via the Settings page in the UI) ===
BETFAIR_USERNAME=your_betfair_email
BETFAIR_PASSWORD=your_betfair_password
BETFAIR_APP_KEY=your_live_app_key

# === Server ===
# Port to expose on the host machine (default: 80)
# Change to 8080 if port 80 is taken, or if using a reverse proxy (Caddy/Traefik)
HOST_PORT=80
